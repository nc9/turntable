{
  "name": "turntable-workspace",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "format": "bun fmt",
    "format:check": "bun fmt --check",
    "typecheck": "bun run --sequential typecheck:core typecheck:provider-sdk typecheck:provider-conformance typecheck:provider-docker typecheck:redact typecheck:ui typecheck:act-runner typecheck:daytona typecheck:net typecheck:proxy typecheck:signer",
    "test": "bun run scripts/run-tests.ts",
    "build": "bun run scripts/build.ts",
    "dev": "bun run packages/core/src/main.ts serve",
    "typecheck:core": "bun run --cwd packages/core typecheck",
    "typecheck:provider-sdk": "bun run --cwd packages/provider-sdk typecheck",
    "typecheck:provider-conformance": "bun run --cwd packages/provider-conformance typecheck",
    "test:core": "bun test packages/core/tests/db.test.ts packages/core/tests/server.test.ts packages/core/tests/job-state.test.ts",
    "test:provider": "bun test packages/provider-sdk/tests/sdk.test.ts packages/provider-sdk/tests/read-capped.test.ts packages/provider-sdk/tests/wrapper-watcher.test.ts packages/provider-sdk/tests/legacy-env.test.ts packages/provider-conformance/tests/fake.test.ts packages/provider-conformance/tests/fake-faults.test.ts packages/provider-docker/tests/commands.test.ts packages/provider-docker/tests/legacy-labels.test.ts",
