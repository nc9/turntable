{
  "name": "longshore-workspace",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint",
    "typecheck": "bun run --sequential typecheck:core typecheck:provider-sdk typecheck:provider-conformance typecheck:provider-docker typecheck:redact typecheck:ui typecheck:act-runner",
    "test": "bun run --sequential test:core test:core2 test:core3 test:ops test:ops2 test:sched test:provider test:redact test:ui test:act test:act2 test:run test:scripts test:prereqs",
    "build": "bun run scripts/build.ts",
    "dev": "bun run packages/core/src/main.ts serve",
    "typecheck:core": "bun run --cwd packages/core typecheck",
    "typecheck:provider-sdk": "bun run --cwd packages/provider-sdk typecheck",
    "typecheck:provider-conformance": "bun run --cwd packages/provider-conformance typecheck",
    "test:core": "bun test packages/core/tests/db.test.ts packages/core/tests/server.test.ts packages/core/tests/job-state.test.ts",
    "test:provider": "bun test packages/provider-sdk/tests/sdk.test.ts packages/provider-conformance/tests/fake.test.ts packages/provider-conformance/tests/fake-faults.test.ts packages/provider-docker/tests/commands.test.ts",
    "typecheck:provider-docker": "bun run --cwd packages/provider-docker typecheck",
    "typecheck:redact": "bun run --cwd packages/redact typecheck",
    "typecheck:ui": "bun run --cwd packages/ui typecheck",
    "test:ui": "bun test packages/ui/tests/log-parser.test.ts packages/ui/tests/fixture.test.ts packages/ui/tests/http-adapter.test.ts packages/ui/tests/openapi-contract.test.ts packages/ui/tests/polling-realtime.test.ts packages/ui/tests/ws-adapter.test.ts packages/core/tests/ui-assets.test.ts",
    "test:redact": "bun test packages/redact/tests/redact.test.ts",
    "test:docker": "TT_DOCKER_CONFORMANCE=1 bun test packages/provider-docker/tests/conformance.test.ts",
    "test:core2": "bun test packages/core/tests/migration-parity.test.ts packages/core/tests/tenancy-guard.test.ts packages/core/tests/tenancy.test.ts packages/core/tests/db-transaction.test.ts",
    "test:ops": "bun test packages/core/tests/ops-dispatch.test.ts packages/core/tests/ops-ops.test.ts packages/core/tests/ops-rest.test.ts packages/core/tests/ops-openapi.test.ts packages/core/tests/ops-cli.test.ts packages/core/tests/realtime.test.ts",
    "openapi:gen": "bun run --cwd packages/core openapi:gen",
    "typecheck:act-runner": "bun run --cwd packages/act-runner typecheck",
    "test:act": "bun test packages/act-runner/tests/plan.test.ts packages/act-runner/tests/events.test.ts packages/act-runner/tests/run-job.test.ts packages/act-runner/tests/expr.test.ts packages/act-runner/tests/triggers.test.ts",
    "test:act-e2e": "TT_ACT_E2E=1 bun test packages/act-runner/tests/e2e.test.ts",
    "test:core3": "bun test packages/core/tests/events.test.ts packages/core/tests/migration-rebuild.test.ts",
    "test:ops2": "bun test packages/core/tests/ops-events.test.ts packages/core/tests/ops-gaps.test.ts",
    "test:run": "bun test packages/core/tests/run-local.test.ts packages/core/tests/repo-archive.test.ts packages/core/tests/run-workflow.test.ts",
    "test:run-e2e": "TT_RUN_E2E=1 bun test packages/core/tests/run-e2e.test.ts",
    "test:act2": "bun test packages/act-runner/tests/workflow-plan.test.ts packages/act-runner/tests/split.test.ts packages/act-runner/tests/readiness.test.ts packages/act-runner/tests/squirrelscan-plan.test.ts",
    "test:sched": "bun test packages/core/tests/scheduler.test.ts packages/core/tests/poll.test.ts packages/core/tests/reattach.test.ts",
    "test:scripts": "bun test scripts/rcodesign.test.ts",
    "test:prereqs": "bun test packages/core/tests/release-prereqs.test.ts packages/core/tests/legacy-names.test.ts"
  },
  "devDependencies": {
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "oxfmt": "0.77.0",
    "oxlint": "1.92.0"
  }
}
