{
  "name": "turntable-workspace",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "format": "bun fmt",
    "format:check": "bun fmt --check",
    "typecheck": "bun run --sequential typecheck:core typecheck:provider-sdk typecheck:provider-conformance typecheck:provider-docker typecheck:redact typecheck:ui typecheck:act-runner typecheck:daytona typecheck:net typecheck:proxy typecheck:signer",
    "test": "bun run scripts/run-tests.ts",
    "build": "bun run scripts/build.ts",
    "dev": "bun run packages/core/src/main.ts serve",
    "typecheck:core": "bun run --cwd packages/core typecheck",
    "typecheck:provider-sdk": "bun run --cwd packages/provider-sdk typecheck",
    "typecheck:provider-conformance": "bun run --cwd packages/provider-conformance typecheck",
    "test:core": "bun scripts/run-test-group.ts core",
    "test:provider": "bun scripts/run-test-group.ts provider",
    "typecheck:provider-docker": "bun run --cwd packages/provider-docker typecheck",
    "typecheck:redact": "bun run --cwd packages/redact typecheck",
    "typecheck:ui": "bun run --cwd packages/ui typecheck",
    "typecheck:daytona": "bun run --cwd packages/provider-daytona typecheck",
    "test:daytona": "bun scripts/run-test-group.ts daytona",
    "test:ui": "bun scripts/run-test-group.ts ui",
    "test:redact": "bun scripts/run-test-group.ts redact",
    "test:docker": "TT_DOCKER_CONFORMANCE=1 bun scripts/run-test-group.ts docker",
    "test:core2": "bun scripts/run-test-group.ts core2",
    "test:ops": "bun scripts/run-test-group.ts ops",
    "mcp-tools:check": "bun run scripts/mcp-tools.ts --check",
    "openapi:gen": "bun run --cwd packages/core openapi:gen",
    "typecheck:act-runner": "bun run --cwd packages/act-runner typecheck",
    "test:act": "bun scripts/run-test-group.ts act",
    "test:missing-tool-e2e": "TT_ACT_E2E=1 bun scripts/run-test-group.ts missing-tool-e2e",
    "test:proxy-e2e": "TT_PROXY_E2E=1 bun scripts/run-test-group.ts proxy-e2e",
    "test:cache-encrypted": "TURNTABLE_TEST_CACHE_ENCRYPT=1 bun scripts/run-test-group.ts cache-encrypted",
    "test:cache-blobs": "bun scripts/run-test-group.ts cache-blobs",
    "test:vault-e2e": "TT_VAULT_E2E=1 bun scripts/run-test-group.ts vault-e2e",
    "test:artifacts": "bun scripts/run-test-group.ts artifacts",
    "test:artifacts-e2e": "TT_ARTIFACTS_E2E=1 bun scripts/run-test-group.ts artifacts-e2e",
    "test:cache-e2e": "TT_CACHE_E2E=1 bun scripts/run-test-group.ts cache-e2e",
    "test:act-e2e": "TT_ACT_E2E=1 bun scripts/run-test-group.ts act-e2e",
    "test:core3": "bun scripts/run-test-group.ts core3",
    "test:ops2": "bun scripts/run-test-group.ts ops2",
    "test:run": "bun scripts/run-test-group.ts run",
    "test:run-e2e": "TT_RUN_E2E=1 bun scripts/run-test-group.ts run-e2e",
    "test:act2": "bun scripts/run-test-group.ts act2",
    "test:sched": "bun scripts/run-test-group.ts sched",
    "test:scripts": "bun scripts/run-test-group.ts scripts",
    "test:prereqs": "bun scripts/run-test-group.ts prereqs",
    "test:github": "bun scripts/run-test-group.ts github",
    "test:trust": "bun scripts/run-test-group.ts trust",
    "test:oidc": "bun scripts/run-test-group.ts oidc",
    "test:tenant": "bun scripts/run-test-group.ts tenant",
    "pg:test": "bun run scripts/run-tests-pg.ts",
    "test:pg-parity": "bun scripts/run-test-group.ts pg-parity",
    "test:hosted": "bun scripts/run-test-group.ts hosted",
    "test:parity": "bun scripts/run-test-group.ts parity",
    "test:usage": "bun scripts/run-test-group.ts usage",
    "test:release": "bun scripts/run-test-group.ts release",
    "test:golden": "bun scripts/run-test-group.ts golden",
    "test:ingest": "bun scripts/run-test-group.ts ingest",
    "test:doctor": "bun scripts/run-test-group.ts doctor",
    "test:vault": "bun scripts/run-test-group.ts vault",
    "test:audit": "bun scripts/run-test-group.ts audit",
    "test:transport": "bun scripts/run-test-group.ts transport",
    "test:privileges": "bun scripts/run-test-group.ts privileges",
    "test:pins": "bun scripts/run-test-group.ts pins",
    "typecheck:net": "bun run --cwd packages/net typecheck",
    "typecheck:proxy": "bun run --cwd packages/proxy typecheck",
    "test:proxy": "bun scripts/run-test-group.ts proxy",
    "typecheck:signer": "bun run --cwd packages/signer typecheck",
    "test:signer": "bun scripts/run-test-group.ts signer",
    "test:net": "bun scripts/run-test-group.ts net",
    "test:tar": "bun scripts/run-test-group.ts tar",
    "test:checkout": "bun scripts/run-test-group.ts checkout",
    "test:quota-ops": "bun scripts/run-test-group.ts quota-ops",
    "test:events-stream": "bun scripts/run-test-group.ts events-stream",
    "test:artifacts-core": "bun scripts/run-test-group.ts artifacts-core",
    "test:security-misc": "bun scripts/run-test-group.ts security-misc",
    "test:routing": "bun scripts/run-test-group.ts routing",
    "test:ui-more": "bun scripts/run-test-group.ts ui-more",
    "test:exec-wrapper": "bun scripts/run-test-group.ts exec-wrapper",
    "test:pg-only": "bun scripts/run-test-group.ts pg-only",
    "test:poll-usage": "bun scripts/run-test-group.ts poll-usage",
    "test:project-settings": "bun scripts/run-test-group.ts project-settings",
    "test:sandbox-size": "bun scripts/run-test-group.ts sandbox-size"
  }
}
