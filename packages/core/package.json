{
  "name": "@longshore/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./realtime-protocol": "./src/realtime/protocol.ts"
  },
  "scripts": {
    "typecheck": "tsgo --noEmit -p tsconfig.json",
    "db:generate": "drizzle-kit generate && bun run scripts/gen-migrations.ts",
    "db:embed": "bun run scripts/gen-migrations.ts",
    "openapi:gen": "bun run scripts/gen-openapi.ts"
  },
  "dependencies": {
    "@longshore/act-runner": "workspace:*",
    "@longshore/provider-docker": "workspace:*",
    "@longshore/provider-sdk": "workspace:*",
    "@longshore/redact": "workspace:*",
    "drizzle-orm": "0.45.4",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "drizzle-kit": "0.31.11"
  }
}
